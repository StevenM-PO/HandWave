{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-mingw",
      "displayName": "Windows (Qt 6.12 MinGW)",
      "description": "Desktop prototype build using the Qt-bundled MinGW toolchain and Ninja.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "environment": {
        "PATH": "C:/Qt/Tools/mingw1310_64/bin;C:/Qt/6.12.0/mingw_64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.12.0/mingw_64",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/Ninja/ninja.exe",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe"
      }
    },
    {
      "name": "pi",
      "displayName": "Raspberry Pi (native build, system Qt)",
      "description": "Build on the Pi itself against apt's Qt 6 packages.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-mingw", "configurePreset": "windows-mingw" },
    { "name": "pi", "configurePreset": "pi" }
  ],
  "testPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "pi",
      "configurePreset": "pi",
      "output": { "outputOnFailure": true }
    }
  ]
}
